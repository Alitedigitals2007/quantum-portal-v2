<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Course Materials | Admin Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
        .sidebar-link:hover { background-color: rgba(255,255,255,0.05); }
        .input-box { width: 100%; padding: 12px; border: 1px solid #e2e8f0; border-radius: 12px; font-size: 14px; outline: none; transition: 0.2s; background: #fff; }
        .input-box:focus { border-color: #3b82f6; box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.05); }
    </style>
</head>
<body class="flex min-h-screen">

    <aside class="w-64 bg-slate-950 text-slate-400 hidden md:flex flex-col sticky top-0 h-screen border-r border-slate-900">
        <div class="p-8">
            <span class="text-2xl font-black text-white italic">Edu<span class="text-blue-500">Link</span></span>
        </div>
        <nav class="flex-1 px-4 space-y-1">
            <a href="/admin/dashboard" class="sidebar-link flex items-center p-3 rounded-xl text-sm font-medium">Dashboard</a>
            <a href="/admin/courses" class="sidebar-link flex items-center p-3 rounded-xl text-sm font-medium">Courses</a>
            <a href="/admin/materials" class="bg-blue-600 text-white flex items-center p-3 rounded-xl text-sm font-bold shadow-lg">Materials</a>
        </nav>
    </aside>

    <main class="flex-1 flex flex-col">
        <header class="bg-white border-b border-slate-200 px-8 py-4 flex justify-between items-center">
            <h2 class="text-xs font-bold text-slate-400 uppercase tracking-widest">Resource Manager</h2>
            <div class="flex items-center gap-3">
                <span class="text-xs font-bold text-slate-900"><%= user.name %></span>
                <div class="w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center text-white text-[10px] font-bold"><%= user.name[0] %></div>
            </div>
        </header>

        <div class="p-8 max-w-7xl mx-auto w-full">
            <div class="flex justify-between items-end mb-8">
                <div>
                    <h1 class="text-4xl font-black text-slate-900 tracking-tight">Learning Materials</h1>
                    <p class="text-slate-500 text-sm">Add Google Drive links for students to access lecture notes.</p>
                </div>
                <button onclick="document.getElementById('linkModal').style.display='flex'" class="px-6 py-3 bg-blue-600 text-white rounded-2xl font-bold text-sm shadow-xl hover:bg-blue-700 transition">
                    + Add Drive Link
                </button>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <% materials.forEach(item => { %>
                <div class="bg-white p-6 rounded-[2rem] border border-slate-200 shadow-sm hover:shadow-md transition group">
                    <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-2xl flex items-center justify-center mb-4 group-hover:bg-emerald-600 group-hover:text-white transition">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.826a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
                    </div>
                    <h3 class="font-bold text-slate-900 text-lg mb-1"><%= item.title %></h3>
                    <p class="text-[10px] font-black text-blue-500 uppercase tracking-widest mb-4"><%= item.course_code %></p>
                    <a href="<%= item.drive_link %>" target="_blank" class="flex items-center justify-center gap-2 w-full bg-slate-50 py-3 rounded-xl text-xs font-black text-slate-600 hover:bg-blue-600 hover:text-white transition">
                        OPEN IN DRIVE 
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                    </a>
                </div>
                <% }); %>
            </div>
        </div>
    </main>

    <div id="linkModal" class="fixed inset-0 bg-slate-900/80 hidden items-center justify-center p-4 z-50 backdrop-blur-sm">
        <div class="bg-white rounded-[2.5rem] w-full max-w-md p-8 shadow-2xl">
            <h2 class="text-2xl font-black text-slate-900 mb-2">New Material Link</h2>
            <p class="text-xs text-slate-400 mb-6">Paste your Google Drive sharing link below.</p>
            
            <form action="/admin/materials/add-link" method="POST" class="space-y-4">
                <div>
                    <label class="text-[10px] font-black text-slate-400 uppercase mb-1 block">Course</label>
                    <select name="course_code" class="input-box" required>
                        <option value="">Select Course...</option>
                        <% courses.forEach(c => { %>
                            <option value="<%= c.course_code %>"><%= c.course_code %> - <%= c.course_title %></option>
                        <% }); %>
                    </select>
                </div>
                <div>
                    <label class="text-[10px] font-black text-slate-400 uppercase mb-1 block">Document Title</label>
                    <input type="text" name="title" placeholder="e.g. GST 101 Lecture Notes" class="input-box" required>
                </div>
                <div>
                    <label class="text-[10px] font-black text-slate-400 uppercase mb-1 block">Drive Link (URL)</label>
                    <input type="url" name="drive_link" placeholder="https://drive.google.com/..." class="input-box" required>
                </div>
                
                <div class="flex gap-3 pt-6">
                    <button type="submit" class="flex-1 bg-blue-600 text-white py-4 rounded-2xl font-bold text-sm">Save Link</button>
                    <button type="button" onclick="document.getElementById('linkModal').style.display='none'" class="flex-1 bg-slate-100 text-slate-500 py-4 rounded-2xl font-bold text-sm">Cancel</button>
                </div>
            </form>
        </div>
    </div>

</body>
</html>