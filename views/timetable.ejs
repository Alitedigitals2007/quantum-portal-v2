<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Quantum Squad | Academic Schedule</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f0f4f8; color: #1e293b; }
        .table-container { overflow-x: auto; position: relative; border-radius: 2rem; }
        
        /* Sticky Column for Days */
        .sticky-day { 
            position: sticky; left: 0; z-index: 20; 
            background: #ffffff; 
            border-right: 2px solid #e2e8f0;
            min-width: 100px;
            box-shadow: 10px 0 15px -3px rgba(0, 0, 0, 0.02);
        }

        /* Professional Card Design */
        .course-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            transition: all 0.2s ease;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        }
        .course-card:hover {
            border-color: #3b82f6;
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(59, 130, 246, 0.1);
        }

        /* Free period styling */
        .free-grid {
            background-color: #f8fafc;
            background-image: radial-gradient(#e2e8f0 1px, transparent 1px);
            background-size: 15px 15px;
        }

        @media print { .no-print { display: none !important; } }
    </style>
</head>
<body class="p-4 md:p-8">

    <nav class="max-w-[1600px] mx-auto bg-white border border-slate-200 px-8 py-5 rounded-3xl mb-8 flex justify-between items-center no-print shadow-sm">
        <div class="flex items-center gap-10">
            <div class="text-2xl font-black tracking-tighter italic uppercase text-slate-900">
                THE <span class="text-blue-600">QUANTUM</span> SQUAD
            </div>
            <div class="hidden lg:flex gap-8 text-[10px] font-bold uppercase tracking-[0.2em] text-slate-400">
                <a href="/dashboard" class="hover:text-blue-600 transition">Dashboard</a>
                <a href="/timetable" class="text-blue-600 border-b-2 border-blue-600 pb-1">Timetable</a>
                <a href="/materials" class="hover:text-blue-600 transition">Resources</a>
            </div>
        </div>
        <button onclick="exportToPDF()" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-2xl text-xs font-black tracking-widest transition-all shadow-lg shadow-blue-600/20 uppercase active:scale-95">
            Download PDF
        </button>
    </nav>

    <div id="pdf-area" class="max-w-[1600px] mx-auto bg-white rounded-[3rem] border border-slate-200 shadow-2xl overflow-hidden">
        
        <div class="p-10 text-center bg-blue-600 text-white">
            <h1 class="text-3xl font-black tracking-tight uppercase">Lecture Master Schedule</h1>
            <p class="text-blue-100 text-[10px] font-bold uppercase tracking-[0.4em] mt-2 italic">Quantum Squad Engineering Portal</p>
        </div>

        <div class="table-container">
            <table class="w-full border-collapse">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-200">
                        <th class="p-6 sticky-day text-[10px] font-black text-slate-400 uppercase">Day</th>
                        <% 
                            const slots = ["08:00 - 09:00", "09:00 - 10:00", "10:00 - 11:00", "11:00 - 12:00", "12:00 - 01:00", "01:00 - 02:00", "02:00 - 03:00", "03:00 - 04:00", "04:00 - 05:00"];
                            slots.forEach(slot => { 
                        %>
                            <th class="p-6 border-r border-slate-100 min-w-[220px] text-blue-600 font-black text-xs text-center">
                                <%= slot %>
                            </th>
                        <% }); %>
                    </tr>
                </thead>
                <tbody class="free-grid">
                    <% 
                        const days = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'];
                        days.forEach(day => { 
                    %>
                        <tr class="border-b border-slate-100 h-40">
                            <td class="p-6 sticky-day font-black text-slate-800 text-sm uppercase italic text-center">
                                <%= day %>
                            </td>

                            <% slots.forEach(slot => { 
                                const hourPrefix = slot.split(':')[0].replace(/^0/, ''); 
                                const session = timetable.find(t => 
                                    t.day_of_week.trim().toLowerCase() === day.toLowerCase() && 
                                    t.time_slot.trim().replace(/^0/, '').startsWith(hourPrefix)
                                );
                            %>
                                <td class="p-3 border-r border-slate-100 min-w-[220px]">
                                    <% if (session) { %>
                                        <div class="course-card p-5 h-full rounded-[2rem] flex flex-col justify-between border-l-4 border-l-blue-600">
                                            <div>
                                                <div class="text-[10px] font-black text-blue-600 uppercase tracking-tighter mb-1">
                                                    <%= session.course_code %>
                                                </div>
                                                <div class="text-[13px] font-bold text-slate-900 leading-tight line-clamp-2">
                                                    <%= session.course_title %>
                                                </div>
                                            </div>
                                            <div class="mt-4 pt-4 border-t border-slate-50">
                                                <div class="text-[10px] font-medium text-slate-400 italic truncate mb-1">
                                                    👤 <%= session.lecturer || 'Dept. Lecturer' %>
                                                </div>
                                                <div class="text-[10px] font-black uppercase text-blue-500 tracking-tighter truncate">
                                                    📍 <%= session.venue_name %>
                                                </div>
                                            </div>
                                        </div>
                                    <% } else { %>
                                        <div class="h-full w-full flex items-center justify-center opacity-20">
                                            <div class="w-1.5 h-1.5 rounded-full bg-slate-300"></div>
                                        </div>
                                    <% } %>
                                </td>
                            <% }); %>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>

    <script>
        function exportToPDF() {
            const element = document.getElementById('pdf-area');
            const opt = {
                margin: 0.2,
                filename: 'The_Quantum_Squad_Schedule.pdf',
                image: { type: 'jpeg', quality: 1 },
                html2canvas: { scale: 2, useCORS: true },
                jsPDF: { unit: 'in', format: 'a3', orientation: 'landscape' }
            };
            html2pdf().set(opt).from(element).save();
        }
    </script>
</body>
</html>