<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Quantum Squad | Academic Schedule</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f0f4f8; color: #1e293b; overflow-x: hidden; }
        
        /* Desktop Table Layout */
        .table-container { overflow-x: auto; position: relative; border-radius: 2rem; }
        .sticky-day { 
            position: sticky; left: 0; z-index: 20; 
            background: #ffffff; border-right: 2px solid #e2e8f0; min-width: 100px;
        }

        /* Course Card Aesthetics */
        .course-card {
            background: #ffffff; border: 1px solid #e2e8f0;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        }
        .free-grid {
            background-color: #f8fafc;
            background-image: radial-gradient(#e2e8f0 1px, transparent 1px);
            background-size: 15px 15px;
        }

        /* Live Session Highlight */
        .live-session {
            border: 2px solid #2563eb !important;
            box-shadow: 0 0 25px rgba(37, 99, 235, 0.25) !important;
            transform: scale(1.02);
            z-index: 10;
        }
        .live-badge {
            display: none;
            animation: pulse 2s infinite;
        }
        .live-session .live-badge { display: inline-block; }

        @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

        /* Responsive Visibility */
        @media (max-width: 1023px) { .desktop-table { display: none; } .mobile-view { display: block; } }
        @media (min-width: 1024px) { .desktop-table { display: block; } .mobile-view { display: none; } }
        @media print { .no-print { display: none !important; } }
    </style>
</head>
<body class="p-3 md:p-8">

    <nav class="max-w-[1600px] mx-auto bg-white border border-slate-200 px-6 py-4 rounded-3xl mb-6 flex justify-between items-center no-print shadow-sm">
        <div class="flex items-center gap-6">
            <div class="text-xl font-black tracking-tighter italic uppercase text-slate-900">
                THE <span class="text-blue-600">QUANTUM</span> SQUAD
            </div>
            <div class="hidden lg:flex gap-8 text-[10px] font-bold uppercase tracking-[0.2em] text-slate-400">
                <a href="/dashboard" class="hover:text-blue-600 transition">Dashboard</a>
                <a href="/timetable" class="text-blue-600 border-b-2 border-blue-600 pb-1">Timetable</a>
                <a href="/materials" class="hover:text-blue-600 transition">Resources</a>
            </div>
        </div>
        <button onclick="exportToPDF()" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-xl text-[10px] font-black tracking-widest transition-all shadow-lg shadow-blue-600/20 uppercase active:scale-95">
            Save PDF
        </button>
    </nav>

    <div id="pdf-area" class="max-w-[1600px] mx-auto bg-white rounded-[2rem] lg:rounded-[3rem] border border-slate-200 shadow-2xl overflow-hidden">
        
        <div class="p-6 lg:p-10 text-center bg-blue-600 text-white">
            <h1 class="text-2xl lg:text-3xl font-black tracking-tight uppercase">Lecture Master Schedule</h1>
            <div id="current-time-display" class="text-blue-200 text-[10px] font-bold uppercase tracking-[0.3em] mt-2 italic">
                Quantum Squad Engineering Portal
            </div>
        </div>

        <% 
            const slots = ["08:00 - 09:00", "09:00 - 10:00", "10:00 - 11:00", "11:00 - 12:00", "12:00 - 01:00", "01:00 - 02:00", "02:00 - 03:00", "03:00 - 04:00", "04:00 - 05:00"];
            const days = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'];
        %>

        <div class="desktop-table table-container">
            <table class="w-full border-collapse">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-200">
                        <th class="p-6 sticky-day text-[10px] font-black text-slate-400 uppercase">Day</th>
                        <% slots.forEach(slot => { %>
                            <th class="p-6 border-r border-slate-100 min-w-[220px] text-blue-600 font-black text-xs text-center">
                                <%= slot %>
                            </th>
                        <% }); %>
                    </tr>
                </thead>
                <tbody class="free-grid">
                    <% days.forEach(day => { %>
                        <tr class="border-b border-slate-100 h-44">
                            <td class="p-6 sticky-day font-black text-slate-800 text-sm uppercase italic text-center">
                                <%= day %>
                            </td>
                            <% slots.forEach(slot => { 
                                const hourPrefix = slot.split(':')[0].replace(/^0/, ''); 
                                const session = timetable.find(t => 
                                    t.day_of_week.trim().toLowerCase() === day.toLowerCase() && 
                                    t.time_slot.trim().replace(/^0/, '').startsWith(hourPrefix)
                                );
                            %>
                                <td class="p-3 border-r border-slate-100 min-w-[220px]">
                                    <% if (session) { %>
                                        <div class="course-card session-node p-5 h-full rounded-[2rem] flex flex-col justify-between border-l-4 border-l-blue-600"
                                             data-day="<%= day.toLowerCase() %>" data-start="<%= slot.split(' - ')[0] %>" data-end="<%= slot.split(' - ')[1] %>">
                                            <div>
                                                <div class="flex justify-between items-center mb-1">
                                                    <span class="text-[10px] font-black text-blue-600 uppercase tracking-tighter"><%= session.course_code %></span>
                                                    <span class="live-badge text-[8px] font-black text-blue-600 bg-blue-50 px-2 py-0.5 rounded-full">ONGOING</span>
                                                </div>
                                                <div class="text-[13px] font-bold text-slate-900 leading-tight line-clamp-2"><%= session.course_title %></div>
                                            </div>
                                            <div class="mt-4 pt-4 border-t border-slate-50">
                                                <div class="text-[10px] font-medium text-slate-400 italic truncate mb-1">👤 <%= session.lecturer || 'Dept. Lecturer' %></div>
                                                <div class="text-[10px] font-black uppercase text-blue-500 tracking-tighter truncate">📍 <%= session.venue_name %></div>
                                            </div>
                                        </div>
                                    <% } else { %>
                                        <div class="h-full w-full flex items-center justify-center opacity-20"><div class="w-1.5 h-1.5 rounded-full bg-slate-300"></div></div>
                                    <% } %>
                                </td>
                            <% }); %>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>

        <div class="mobile-view p-4 space-y-8 bg-slate-50">
            <% days.forEach(day => { %>
                <div class="day-group" data-day-name="<%= day.toLowerCase() %>">
                    <h3 class="text-xs font-black text-blue-600 uppercase tracking-widest mb-4 flex items-center gap-2">
                        <span class="w-8 h-[2px] bg-blue-600"></span> <%= day %>
                    </h3>
                    <div class="space-y-3">
                        <% 
                            let hasClasses = false;
                            slots.forEach(slot => { 
                                const hourPrefix = slot.split(':')[0].replace(/^0/, ''); 
                                const session = timetable.find(t => 
                                    t.day_of_week.trim().toLowerCase() === day.toLowerCase() && 
                                    t.time_slot.trim().replace(/^0/, '').startsWith(hourPrefix)
                                );
                                if (session) { hasClasses = true;
                        %>
                            <div class="bg-white p-5 rounded-[1.5rem] border border-slate-200 shadow-sm flex gap-4 session-node"
                                 data-day="<%= day.toLowerCase() %>" data-start="<%= slot.split(' - ')[0] %>" data-end="<%= slot.split(' - ')[1] %>">
                                <div class="text-[10px] font-black text-slate-400 border-r border-slate-100 pr-4 flex items-center text-center leading-tight min-w-[65px]">
                                    <%= slot.split('-')[0] %><br>to<br><%= slot.split('-')[1] %>
                                </div>
                                <div class="flex-1 relative">
                                    <div class="flex justify-between items-start mb-1">
                                        <span class="text-[10px] font-black text-blue-600 uppercase"><%= session.course_code %></span>
                                        <span class="live-badge text-[8px] font-black text-blue-600 bg-blue-50 px-2 py-0.5 rounded-full">LIVE</span>
                                    </div>
                                    <div class="text-sm font-extrabold text-slate-900"><%= session.course_title %></div>
                                    <div class="text-[10px] text-slate-500 mt-2 italic">👤 <%= session.lecturer || 'Dept. Lecturer' %> | 📍 <%= session.venue_name %></div>
                                </div>
                            </div>
                        <% } }); if (!hasClasses) { %>
                            <div class="text-[10px] font-bold text-slate-300 uppercase italic p-4 border-2 border-dashed border-slate-200 rounded-[1.5rem] text-center">No Lectures</div>
                        <% } %>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>

    <script>
        // PDF Export Configuration
        function exportToPDF() {
            const element = document.getElementById('pdf-area');
            const opt = {
                margin: 0.1,
                filename: 'Quantum_Squad_Schedule.pdf',
                image: { type: 'jpeg', quality: 1 },
                html2canvas: { scale: 2, useCORS: true },
                jsPDF: { unit: 'in', format: 'a3', orientation: 'landscape' }
            };
            html2pdf().set(opt).from(element).save();
        }

        // Live Tracking Logic
        function updateLiveSessions() {
            const now = new Date();
            const days = ['sunday', 'monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday'];
            const currentDay = days[now.getDay()];
            
            // Format 24h for comparison
            const currentTime = now.getHours().toString().padStart(2, '0') + ":" + 
                                now.getMinutes().toString().padStart(2, '0');

            function to24h(timeStr) {
                let [hrs, mins] = timeStr.trim().split(':');
                hrs = parseInt(hrs);
                // Simple heuristic: slots starting 1:00-5:00 are PM (13-17)
                if (hrs >= 1 && hrs <= 5) hrs += 12;
                return `${hrs.toString().padStart(2, '0')}:${mins}`;
            }

            document.querySelectorAll('.session-node').forEach(node => {
                const sessionDay = node.dataset.day;
                const startTime = to24h(node.dataset.start);
                const endTime = to24h(node.dataset.end);

                if (currentDay === sessionDay && currentTime >= startTime && currentTime < endTime) {
                    node.classList.add('live-session');
                } else {
                    node.classList.remove('live-session');
                }
            });
        }

        // Initialize Engine
        setInterval(updateLiveSessions, 30000); // Check every 30 seconds
        updateLiveSessions();
    </script>
</body>
</html>