<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Course Management | Admin Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; color: #1e293b; }
        .input-field { width: 100%; padding: 12px; border: 1px solid #e2e8f0; border-radius: 10px; font-size: 14px; outline: none; transition: all 0.2s; }
        .input-field:focus { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1); }
        .modal { display: none; align-items: center; justify-content: center; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.7); z-index: 50; backdrop-filter: blur(4px); }
        .modal.active { display: flex; }
    </style>
</head>
<body class="flex min-h-screen">

    <aside class="w-64 bg-slate-900 text-slate-300 hidden md:flex flex-col sticky top-0 h-screen">
        <div class="p-8">
            <span class="text-2xl font-bold text-white tracking-tighter italic">Edu<span class="text-blue-500">Link</span></span>
        </div>
        <nav class="flex-1 px-4 space-y-1">
            <a href="/admin/dashboard" class="flex items-center p-3 rounded-xl text-sm font-medium hover:bg-slate-800 transition">Dashboard</a>
            <a href="/admin/students" class="flex items-center p-3 rounded-xl text-sm font-medium hover:bg-slate-800 transition">Students</a>
            <a href="/admin/courses" class="bg-blue-600 text-white flex items-center p-3 rounded-xl text-sm font-bold shadow-lg shadow-blue-900/20">Courses</a>
            <a href="/admin/materials" class="flex items-center p-3 rounded-xl text-sm font-medium hover:bg-slate-800 transition">Materials</a>
        </nav>
        <div class="p-6 border-t border-slate-800 text-center">
            <a href="/logout" class="text-xs font-bold text-slate-500 hover:text-red-400">SIGN OUT</a>
        </div>
    </aside>

    <main class="flex-1 flex flex-col">
        <header class="bg-white border-b border-slate-200 px-8 py-4 flex justify-between items-center sticky top-0 z-10">
            <h2 class="text-sm font-bold text-slate-500 uppercase tracking-widest">Academic Curriculum</h2>
            <div class="flex items-center gap-3">
                <span class="text-xs font-semibold text-slate-900"><%= user.name %></span>
                <div class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 font-bold text-xs uppercase">
                    <%= user.name.charAt(0) %>
                </div>
            </div>
        </header>

        <div class="p-8 max-w-6xl w-full mx-auto">
            <div class="flex flex-col md:flex-row justify-between items-end mb-8 gap-4">
                <div>
                    <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Courses</h1>
                    <p class="text-slate-500 text-sm">Manage course details, lecturers, and credit units.</p>
                </div>
                <div class="flex gap-3">
                    <button onclick="openModal('bulkModal')" class="px-6 py-2.5 bg-white border border-slate-300 rounded-xl font-bold text-sm hover:bg-slate-50 transition">Bulk CSV</button>
                    <button onclick="openAddModal()" class="px-6 py-2.5 bg-blue-600 text-white rounded-xl font-bold text-sm hover:bg-blue-700 shadow-lg shadow-blue-200 transition">+ New Course</button>
                </div>
            </div>

            <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
                <table class="w-full text-left">
                    <thead class="bg-slate-50 border-b border-slate-100">
                        <tr>
                            <th class="p-5 text-[11px] font-bold text-slate-400 uppercase tracking-widest">Code</th>
                            <th class="p-5 text-[11px] font-bold text-slate-400 uppercase tracking-widest">Title</th>
                            <th class="p-5 text-[11px] font-bold text-slate-400 uppercase tracking-widest">Lecturer</th>
                            <th class="p-5 text-[11px] font-bold text-slate-400 uppercase tracking-widest text-center">Units</th>
                            <th class="p-5 text-[11px] font-bold text-slate-400 uppercase tracking-widest text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50">
                        <% courses.forEach(course => { %>
                        <tr class="hover:bg-blue-50/20 transition-colors">
                            <td class="p-5 font-bold text-sm text-blue-600"><%= course.course_code %></td>
                            <td class="p-5 text-sm font-semibold text-slate-800"><%= course.course_title %></td>
                            <td class="p-5 text-sm text-slate-500"><%= course.lecturer_name || 'Not Assigned' %></td>
                            <td class="p-5 text-center"><span class="bg-slate-100 text-slate-700 px-3 py-1 rounded font-bold text-xs"><%= course.units %></span></td>
                            <td class="p-5">
                                <div class="flex justify-center gap-4">
                                    <button onclick='openEditModal(<%= JSON.stringify(course) %>)' class="text-xs font-bold text-blue-500 hover:underline">EDIT</button>
                                    <a href="/admin/courses/delete?code=<%= encodeURIComponent(course.course_code) %>" onclick="return confirm('Delete course?')" class="text-xs font-bold text-red-400 hover:underline">DELETE</a>
                                </div>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <div id="courseModal" class="modal p-4">
        <div class="bg-white rounded-3xl w-full max-w-md shadow-2xl overflow-hidden">
            <div class="p-8 border-b border-slate-50 bg-slate-50/50">
                <h2 id="modalTitle" class="text-xl font-bold text-slate-900">Add New Course</h2>
            </div>
            <form action="/admin/courses/save" method="POST" class="p-8 space-y-4">
                <input type="hidden" name="isEdit" id="isEdit" value="false">
                
                <div>
                    <label class="text-[10px] font-bold text-slate-400 uppercase mb-1 block">Course Code</label>
                    <input type="text" name="course_code" id="m_code" placeholder="e.g. PHY 301" class="input-field" required>
                </div>
                <div>
                    <label class="text-[10px] font-bold text-slate-400 uppercase mb-1 block">Course Title</label>
                    <input type="text" name="course_title" id="m_title" placeholder="Course Name" class="input-field" required>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="text-[10px] font-bold text-slate-400 uppercase mb-1 block">Lecturer</label>
                        <input type="text" name="lecturer" id="m_lecturer" placeholder="Name" class="input-field">
                    </div>
                    <div>
                        <label class="text-[10px] font-bold text-slate-400 uppercase mb-1 block">Units</label>
                        <input type="number" name="units" id="m_units" placeholder="3" class="input-field">
                    </div>
                </div>
                
                <div class="flex gap-3 pt-6">
                    <button type="submit" class="flex-1 bg-blue-600 text-white py-3.5 rounded-2xl font-bold text-sm shadow-md">Save Changes</button>
                    <button type="button" onclick="closeModal('courseModal')" class="flex-1 bg-slate-100 text-slate-500 py-3.5 rounded-2xl font-bold text-sm">Cancel</button>
                </div>
            </form>
        </div>
    </div>

    <div id="bulkModal" class="modal p-4">
        <div class="bg-white rounded-3xl w-full max-w-sm p-10 text-center shadow-2xl">
            <h2 class="text-xl font-bold text-slate-900 mb-2">Import Courses</h2>
            <p class="text-xs text-slate-400 mb-8 leading-relaxed">
                CSV Headers must be: <br>
                <span class="font-mono text-blue-500">course_code, course_title, lecturer, units</span>
            </p>
            <form action="/admin/courses/bulk" method="POST" enctype="multipart/form-data" class="space-y-4">
                <input type="file" name="csvFile" id="csvFile" accept=".csv" class="hidden" required>
                <div onclick="document.getElementById('csvFile').click()" class="border-2 border-dashed border-slate-200 rounded-2xl p-6 cursor-pointer hover:border-blue-300 transition">
                    <span class="text-sm text-slate-400 font-medium">Click to Select CSV</span>
                </div>
                <button type="submit" class="w-full bg-blue-600 text-white py-3.5 rounded-2xl font-bold text-sm mt-4">Start Upload</button>
                <button type="button" onclick="closeModal('bulkModal')" class="w-full text-slate-400 text-[10px] font-black uppercase mt-2">Close</button>
            </form>
        </div>
    </div>

    <script>
        function openModal(id) { document.getElementById(id).classList.add('active'); }
        function closeModal(id) { document.getElementById(id).classList.remove('active'); }

        function openAddModal() {
            document.getElementById('modalTitle').innerText = "Add New Course";
            document.getElementById('isEdit').value = "false";
            document.getElementById('m_code').readOnly = false;
            document.getElementById('m_code').style.backgroundColor = "white";
            // Clear inputs
            ['m_code', 'm_title', 'm_lecturer', 'm_units'].forEach(id => document.getElementById(id).value = '');
            openModal('courseModal');
        }

        function openEditModal(course) {
            document.getElementById('modalTitle').innerText = "Update Course Details";
            document.getElementById('isEdit').value = "true"; // Tell server to use UPDATE
            document.getElementById('m_code').value = course.course_code;
            document.getElementById('m_code').readOnly = true; // Code cannot be changed during edit
            document.getElementById('m_code').style.backgroundColor = "#f1f5f9";
            
            document.getElementById('m_title').value = course.course_title;
            document.getElementById('m_lecturer').value = course.lecturer_name;
            document.getElementById('m_units').value = course.units;
            openModal('courseModal');
        }
    </script>
</body>
</html>