<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quantum Squad OS | Terminal</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root { --accent: #2563eb; --glass: rgba(255, 255, 255, 0.75); }
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            background: radial-gradient(circle at top right, #f1f5f9, #e2e8f0);
            min-height: 100vh;
        }
        
        .sidebar {
            width: 280px; height: 95vh; position: fixed; left: 20px; top: 2.5vh;
            background: var(--glass); backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.5); border-radius: 32px;
            transition: 0.4s cubic-bezier(0.4, 0, 0.2, 1); z-index: 50;
        }

        .nav-link {
            display: flex; align-items: center; gap: 12px; padding: 14px 18px;
            border-radius: 20px; color: #64748b; font-size: 13px; font-weight: 700;
            transition: 0.3s; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.05em;
        }

        .nav-link:hover { background: white; color: var(--accent); transform: translateX(5px); }
        .nav-link.active { background: white; color: var(--accent); box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.1); }

        .main-content { margin-left: 320px; padding: 40px; }

        .glass-card { 
            background: var(--glass); backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.7); 
            border-radius: 32px; padding: 32px;
        }

        @media (max-width: 1024px) {
            .sidebar { left: -300px; height: 100vh; top: 0; border-radius: 0; }
            .sidebar.open { left: 0; }
            .main-content { margin-left: 0; padding: 20px; }
        }
    </style>
</head>
<body>

    <aside id="sidebar" class="sidebar p-8 flex flex-col">
        <div class="flex items-center gap-3 mb-12">
            <div class="w-12 h-12 bg-blue-600 rounded-2xl flex items-center justify-center text-white font-black text-2xl shadow-lg">Q</div>
            <div>
                <h1 class="font-black text-lg leading-tight text-slate-900">Quantum</h1>
                <p class="text-[10px] font-bold text-blue-500 uppercase tracking-widest">Core Engine</p>
            </div>
        </div>

        <nav class="flex-1">
            <a href="/dashboard" class="nav-link active"><span>🏠</span> Dashboard</a>
            <a href="/timetable" class="nav-link"><span>📅</span> Timetable Menu</a>
            <a href="/courses" class="nav-link"><span>📚</span> My Courses</a>
            <a href="/materials" class="nav-link"><span>📂</span> Archives</a>
            <a href="/results" class="nav-link"><span>📊</span> Analytics</a>
        </nav>

        <div class="mt-auto">
            <div class="bg-white/60 p-5 rounded-[24px] border border-white">
                <div class="flex items-center gap-3 mb-4">
                    <div class="min-w-[40px] h-10 bg-blue-600 rounded-full flex items-center justify-center text-white font-bold border-2 border-white shadow-sm">
                        <%= user.name.split(' ').map(n => n[0]).join('') %>
                    </div>
                    <div class="overflow-hidden">
                        <p class="text-xs font-black text-slate-900 truncate"><%= user.name %></p>
                        <p class="text-[10px] font-bold text-slate-400"><%= user.matric %></p>
                    </div>
                </div>
                <a href="/logout" class="block w-full text-center py-2.5 bg-red-50 text-red-500 text-[9px] font-black rounded-xl hover:bg-red-500 hover:text-white transition uppercase">Logout</a>
            </div>
        </div>
    </aside>

    <main class="main-content">
        
        <header class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-12">
            <div>
                <div class="flex items-center gap-2 mb-2">
                    <span class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></span>
                    <span class="text-[10px] font-black text-emerald-600 uppercase tracking-widest">System Operational</span>
                </div>
                <h2 class="text-4xl font-black text-slate-900 tracking-tight">Node: <%= user.name %></h2>
            </div>
            
            <div class="flex gap-4">
                <div class="bg-white px-6 py-3 rounded-2xl border border-slate-200 shadow-sm">
                    <p class="text-[9px] font-black text-slate-400 uppercase">Current Level</p>
                    <p class="text-sm font-bold text-blue-600"><%= user.level %></p>
                </div>
                <div class="bg-white px-6 py-3 rounded-2xl border border-slate-200 shadow-sm">
                    <p class="text-[9px] font-black text-slate-400 uppercase">System Time</p>
                    <p id="clock" class="text-sm font-bold text-slate-700">--:--</p>
                </div>
            </div>
        </header>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
            <div class="glass-card lg:col-span-2 flex flex-col md:flex-row items-center gap-12">
                <div class="relative w-44 h-44">
                    <svg class="w-full h-full transform -rotate-90">
                        <circle cx="88" cy="88" r="76" stroke="rgba(37,99,235,0.08)" stroke-width="14" fill="transparent" />
                        <circle cx="88" cy="88" r="76" stroke="#2563eb" stroke-width="14" fill="transparent" 
                            stroke-dasharray="477" stroke-dashoffset="<%= 477 - (477 * (user.cgpa / 5)) %>" 
                            stroke-linecap="round" />
                    </svg>
                    <div class="absolute inset-0 flex flex-col items-center justify-center">
                        <span class="text-5xl font-black text-slate-900"><%= user.cgpa %></span>
                        <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest">Current Index</span>
                    </div>
                </div>

                <div class="flex-1">
                    <h3 class="text-2xl font-black text-slate-900 mb-6">Academic Metrics</h3>
                    <div class="grid grid-cols-2 gap-6">
                        <div class="bg-white/40 p-5 rounded-3xl border border-white">
                            <p class="text-[10px] font-black text-slate-400 uppercase mb-1">Global Rank</p>
                            <p class="text-2xl font-black text-blue-600">#<%= locals.rank || 'N/A' %></p>
                        </div>
                        <div class="bg-white/40 p-5 rounded-3xl border border-white">
                            <p class="text-[10px] font-black text-slate-400 uppercase mb-1">Status</p>
                            <p class="text-lg font-black text-emerald-500">Verified</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="glass-card">
                <div class="flex justify-between items-center mb-8">
                    <h3 class="font-black text-slate-800 text-sm uppercase tracking-widest">Daily Schedule</h3>
                    <div class="text-[10px] font-black text-blue-600 bg-blue-50 px-3 py-1 rounded-full uppercase"><%= new Date().toLocaleDateString('en-GB', { weekday: 'long' }) %></div>
                </div>

                <div class="space-y-4">
                    <% if (locals.timetable && timetable.length > 0) { %>
                        <% timetable.forEach(course => { %>
                            <div class="p-4 bg-white/60 rounded-2xl border border-white hover:border-blue-400 transition-all group">
                                <div class="flex justify-between items-start mb-2">
                                    <span class="text-[10px] font-black text-blue-600 bg-blue-50 px-2 py-0.5 rounded-md uppercase"><%= course.course_code %></span>
                                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest"><%= course.start_time %></span>
                                </div>
                                <p class="text-xs font-bold text-slate-800"><%= course.course_name %></p>
                                <p class="text-[9px] font-bold text-slate-400 uppercase mt-1">Venue: <%= course.venue %></p>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="text-center py-10 opacity-50">
                            <p class="text-xs font-bold text-slate-400 uppercase tracking-widest italic">No classes found for today.</p>
                        </div>
                    <% } %>
                </div>
                
                <a href="/timetable" class="block w-full text-center mt-6 py-3 border-2 border-dashed border-slate-200 rounded-2xl text-[10px] font-black text-slate-400 uppercase hover:border-blue-400 hover:text-blue-500 transition">Open Full Menu</a>
            </div>
        </div>
    </main>

    <script>
        // Real-time Clock logic
        function updateClock() {
            const now = new Date();
            const timeString = now.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
            document.getElementById('clock').innerText = timeString;
        }
        setInterval(updateClock, 1000);
        updateClock();

        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('open');
        }
    </script>
</body>
</html>