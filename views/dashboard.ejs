<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quantum Squad OS | Terminal</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root { --accent: #2563eb; --glass: rgba(255, 255, 255, 0.8); }
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            background: radial-gradient(circle at top right, #f1f5f9, #e2e8f0);
            min-height: 100vh; color: #1e293b; overflow-x: hidden;
        }
        .sidebar {
            width: 280px; height: 95vh; position: fixed; left: 20px; top: 2.5vh;
            background: var(--glass); backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.5); border-radius: 32px;
            transition: 0.4s cubic-bezier(0.4, 0, 0.2, 1); z-index: 100;
        }
        .nav-link {
            display: flex; align-items: center; gap: 12px; padding: 14px 18px;
            border-radius: 20px; color: #64748b; font-size: 13px; font-weight: 700;
            transition: 0.3s; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.05em;
        }
        .nav-link:hover { background: white; color: var(--accent); transform: translateX(5px); }
        .nav-link.active { background: white; color: var(--accent); box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.1); }
        .main-content { margin-left: 320px; padding: 40px; transition: 0.4s; }
        
        .glass-card-hero { 
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(248, 250, 252, 0.8) 100%);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.8);
            border-radius: 48px; padding: 56px;
            position: relative; overflow: hidden;
        }
        .motion-bg {
            position: absolute; top: -50%; right: -10%; width: 600px; height: 600px;
            background: radial-gradient(circle, rgba(37, 99, 235, 0.05) 0%, transparent 70%);
            animation: float 10s infinite alternate; pointer-events: none;
        }
        @keyframes float {
            0% { transform: translate(0, 0); }
            100% { transform: translate(-50px, 50px); }
        }
        .cgpa-ring { transition: stroke-dashoffset 2s cubic-bezier(0.4, 0, 0.2, 1); }

        @media (max-width: 1024px) {
            .sidebar { left: -320px; height: 100vh; top: 0; border-radius: 0; width: 280px; position: fixed; }
            .sidebar.open { left: 0; }
            .main-content { margin-left: 0; padding: 20px; padding-top: 100px; }
            .mobile-overlay { display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.3); z-index: 90; backdrop-filter: blur(4px); }
            .mobile-overlay.active { display: block; }
        }
    </style>
</head>
<body>

    <% 
        const safeStats = stats || {};
        const cgpa = parseFloat(safeStats.cgpa) || 0;
        const passedUnits = safeStats.units || 0;
        const courseCount = safeStats.count || 0;

        const safeUser = user || { name: 'Student' };
        const fullName = safeUser.name || 'Student';
        const firstName = fullName.split(' ')[0];
        const initial = fullName.charAt(0);

        let classification = "Pass";
        let classColor = "text-slate-500 bg-slate-50 border-slate-200";

        if (cgpa >= 3.50) { 
            classification = "First Class"; 
            classColor = "text-amber-600 bg-amber-50 border-amber-200"; 
        } 
        else if (cgpa >= 3.00) { 
            classification = "Second Class (Upper)"; 
            classColor = "text-blue-600 bg-blue-50 border-blue-200"; 
        } 
        else if (cgpa >= 2.00) { 
            classification = "Second Class (Lower)"; 
            classColor = "text-emerald-600 bg-emerald-50 border-emerald-200"; 
        }
        else if (cgpa >= 1.00) { 
            classification = "Third Class"; 
            classColor = "text-orange-600 bg-orange-50 border-orange-200"; 
        }
    %>

    <button onclick="toggleSidebar()" class="lg:hidden fixed top-6 left-6 z-[110] bg-white p-3 rounded-2xl shadow-xl border border-slate-200">
        <svg class="w-6 h-6 text-slate-900" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16m-7 6h7"/></svg>
    </button>

    <div id="overlay" class="mobile-overlay" onclick="toggleSidebar()"></div>

    <aside id="sidebar" class="sidebar p-8 flex flex-col">
        <div class="flex items-center gap-3 mb-12">
            <div class="w-12 h-12 bg-blue-600 rounded-2xl flex items-center justify-center text-white font-black text-2xl shadow-lg">Q</div>
            <div>
                <h1 class="font-black text-lg text-slate-900">Quantum</h1>
                <p class="text-[10px] font-bold text-blue-500 uppercase">Core Engine</p>
            </div>
        </div>

        <nav class="flex-1 space-y-1">
            <a href="/dashboard" class="nav-link active"><span>🏠</span> Dashboard</a>
            <a href="/profile" class="nav-link"><span>👤</span> My Profile</a>
            <a href="/courses" class="nav-link"><span>📚</span> My Courses</a>
            <a href="/timetable" class="nav-link"><span>📅</span> Timetable</a> 
            <a href="/results" class="nav-link"><span>📊</span> Analytics</a>
        </nav>

        <div class="mt-auto">
            <div class="bg-white/60 p-5 rounded-[24px] border border-white">
                <div class="flex items-center gap-3 mb-4">
                    <div class="min-w-[40px] h-10 bg-blue-600 rounded-full flex items-center justify-center text-white font-bold border-2 border-white uppercase"><%= initial %></div>
                    <div class="overflow-hidden">
                        <p class="text-xs font-black truncate text-slate-900 text-ellipsis"><%= fullName %></p>
                        <p class="text-[9px] font-bold text-blue-500 uppercase tracking-tighter"><%= classification %></p>
                    </div>
                </div>
                <a href="/logout" class="block w-full text-center py-2.5 bg-red-50 text-red-500 text-[9px] font-black rounded-xl uppercase">Logout</a>
            </div>
        </div>
    </aside>

    <main class="main-content">
        <header class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-12 px-4">
            <div>
                <div class="flex items-center gap-2 mb-2">
                    <span class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></span>
                    <span class="text-[10px] font-black text-emerald-600 uppercase tracking-[0.4em]">Node Active</span>
                </div>
                <h2 class="text-4xl font-black tracking-tight text-slate-900">Welcome, <%= firstName %></h2>
            </div>
            
            <div class="bg-white/80 backdrop-blur-md px-6 py-4 rounded-[24px] border border-white shadow-sm text-center">
                <p class="text-[8px] font-black text-slate-400 uppercase mb-1 tracking-widest">Local Time</p>
                <p id="clock" class="text-sm font-black text-slate-800 tracking-widest">--:--</p>
            </div>
        </header>

        <div class="glass-card-hero">
            <div class="motion-bg"></div>
            
            <div class="relative z-10 flex flex-col lg:flex-row items-center justify-between gap-16">
                <div class="relative w-80 h-80 flex-shrink-0 group">
                    <div class="absolute inset-0 bg-blue-400/10 rounded-full blur-[60px]"></div>
                    <svg class="w-full h-full transform -rotate-90 relative z-10">
                        <circle cx="160" cy="160" r="140" stroke="rgba(226, 232, 240, 0.4)" stroke-width="24" fill="transparent" />
                        <circle cx="160" cy="160" r="140" stroke="#2563eb" stroke-width="24" fill="transparent" 
                            class="cgpa-ring"
                            stroke-dasharray="880" stroke-dashoffset="<%= 880 - (880 * (cgpa / 4.0)) %>" stroke-linecap="round" />
                    </svg>
                    <div class="absolute inset-0 flex flex-col items-center justify-center z-20">
                        <span class="text-7xl font-black text-slate-900 tracking-tighter"><%= cgpa.toFixed(2) %></span>
                        <span class="text-[12px] font-black text-blue-500 uppercase tracking-[0.4em] mt-3">Quantum Index</span>
                    </div>
                </div>

                <div class="flex-1 w-full space-y-10">
                    <div>
                        <h3 class="text-[10px] font-black mb-6 text-slate-400 uppercase tracking-[0.4em]">Core Classification</h3>
                        <div class="p-10 rounded-[40px] border-2 <%= classColor %> backdrop-blur-sm transition-all hover:translate-y-[-4px] duration-500">
                            <p class="text-[12px] font-black uppercase mb-3 opacity-60 tracking-[0.1em]">Current Standing</p>
                            <p class="text-4xl font-black uppercase tracking-tight text-slate-900"><%= classification %></p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="bg-emerald-50/40 p-8 rounded-[32px] border border-emerald-100 shadow-sm hover:bg-emerald-50 transition-colors">
                            <div class="flex items-center gap-2 mb-1">
                                <div class="w-2 h-2 bg-emerald-500 rounded-full"></div>
                                <p class="text-[10px] font-black text-emerald-600 uppercase tracking-widest">Total Passed</p>
                            </div>
                            <p class="text-3xl font-black text-slate-800"><%= passedUnits %> <span class="text-xs text-slate-400 font-bold uppercase">Units</span></p>
                        </div>

                        <div class="bg-white/40 p-8 rounded-[32px] border border-white/60">
                            <div class="flex items-center gap-4 mb-4">
                                <div class="w-3 h-3 bg-emerald-500 rounded-full animate-ping"></div>
                                <p class="text-[11px] font-black text-slate-600 uppercase tracking-widest">System Sync: Live</p>
                            </div>
                            <div class="space-y-3">
                                <div class="flex justify-between text-[10px] font-bold text-slate-400 uppercase border-b border-white/20 pb-2">
                                    <span>Data Integrity</span>
                                    <span class="text-blue-500 text-right">Weighted Applied</span>
                                </div>
                                <div class="flex justify-between text-[10px] font-bold text-slate-400 uppercase">
                                    <span>Engine State</span>
                                    <span class="text-blue-500 text-right"><%= courseCount %> Courses Synced</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-16 pt-10 border-t border-slate-200/50 flex flex-wrap gap-6 relative z-10">
                <a href="/results" class="flex-1 min-w-[240px] text-center px-8 py-5 bg-slate-900 text-white text-[11px] font-black rounded-[24px] uppercase tracking-[0.2em] hover:bg-blue-600 transition-all shadow-2xl shadow-slate-300 group">
                    Analyze Full Results <span class="inline-block transition-transform group-hover:translate-x-1 ml-2">→</span>
                </a>
                <a href="/profile" class="flex-1 min-w-[240px] text-center px-8 py-5 bg-white text-slate-700 text-[11px] font-black rounded-[24px] border border-slate-200 uppercase tracking-[0.2em] hover:bg-slate-50 transition-all">
                    Initialize Profile Update
                </a>
            </div>
        </div>
    </main>

    <script>
        function updateClock() {
            const now = new Date();
            const clockEl = document.getElementById('clock');
            if(clockEl) {
                clockEl.innerText = now.toLocaleTimeString('en-GB', { 
                    hour: '2-digit', minute: '2-digit', second: '2-digit' 
                });
            }
        }
        setInterval(updateClock, 1000); 
        updateClock();
        
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('overlay');
            if(sidebar && overlay) {
                sidebar.classList.toggle('open');
                overlay.classList.toggle('active');
            }
        }
    </script>
</body>
</html>