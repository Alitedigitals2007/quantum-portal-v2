<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Timetable Manager | Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { background: #f8fafc; font-family: 'Inter', sans-serif; }
        .timetable-grid { display: grid; grid-template-columns: 120px repeat(5, 1fr); gap: 1px; background: #e2e8f0; border: 1px solid #e2e8f0; }
        .cell { background: white; padding: 12px; min-height: 80px; transition: all 0.2s; cursor: pointer; }
        .cell:hover { background: #f1f5f9; }
        .header-cell { background: #f8fafc; font-weight: 700; font-size: 11px; text-transform: uppercase; color: #64748b; padding: 15px; text-align: center; }
    </style>
</head>
<body class="p-8">

    <div class="max-w-7xl mx-auto">
        <header class="flex justify-between items-center mb-8">
            <div>
                <h1 class="text-2xl font-black text-slate-900">Department Timetable</h1>
                <p class="text-slate-500 text-sm">Click any slot to assign a course and venue.</p>
            </div>
            <div class="flex gap-4">
                <form action="/admin/venues/add" method="POST" class="flex gap-2">
                    <input type="text" name="venue_name" placeholder="New Venue (e.g. LT1)" class="px-4 py-2 border rounded-lg text-sm outline-none focus:border-blue-500" required>
                    <button type="submit" class="bg-slate-800 text-white px-4 py-2 rounded-lg text-xs font-bold uppercase">Add Venue</button>
                </form>
            </div>
        </header>

        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
            <div class="timetable-grid">
                <div class="header-cell">Time</div>
                <% days.forEach(day => { %>
                    <div class="header-cell"><%= day %></div>
                <% }); %>

                <% timeSlots.forEach(slot => { %>
                    <div class="header-cell border-t flex items-center justify-center bg-slate-50"><%= slot %></div>
                    <% days.forEach(day => { 
                        // Find entry for this specific day and time
                        const entry = timetable.find(t => t.day_of_week === day && t.time_slot === slot);
                    %>
                        <div class="cell border-t" onclick="openAssignModal('<%= day %>', '<%= slot %>')">
                            <% if(entry) { %>
                                <div class="text-[11px] font-black text-blue-600 uppercase"><%= entry.course_code %></div>
                                <div class="text-[10px] text-slate-500 font-medium truncate"><%= entry.venue_name %></div>
                            <% } else { %>
                                <div class="text-[10px] text-slate-300 italic">Empty</div>
                            <% } %>
                        </div>
                    <% }); %>
                <% }); %>
            </div>
        </div>
    </div>

    <div id="assignModal" class="fixed inset-0 bg-slate-900/60 hidden items-center justify-center p-4 z-50">
        <div class="bg-white rounded-3xl w-full max-w-sm p-8 shadow-2xl">
            <h2 class="text-xl font-bold mb-1" id="displayDayTime">Assign Slot</h2>
            <p class="text-xs text-slate-400 mb-6">Assign a course and location for this period.</p>
            
            <form action="/admin/timetable/save" method="POST" class="space-y-4">
                <input type="hidden" name="day" id="inputDay">
                <input type="hidden" name="time" id="inputTime">
                
                <div>
                    <label class="text-[10px] font-bold text-slate-400 uppercase mb-1 block">Course</label>
                    <select name="course" class="w-full p-3 border rounded-xl text-sm bg-slate-50" required>
                        <option value="">Select Course</option>
                        <% courses.forEach(c => { %>
                            <option value="<%= c.course_code %>"><%= c.course_code %> - <%= c.course_title %></option>
                        <% }); %>
                    </select>
                </div>

                <div>
                    <label class="text-[10px] font-bold text-slate-400 uppercase mb-1 block">Venue</label>
                    <select name="venue" class="w-full p-3 border rounded-xl text-sm bg-slate-50" required>
                        <option value="">Select Venue</option>
                        <% venues.forEach(v => { %>
                            <option value="<%= v.name %>"><%= v.name %></option>
                        <% }); %>
                    </select>
                </div>

                <div class="flex gap-3 pt-4">
                    <button type="submit" class="flex-1 bg-blue-600 text-white py-3 rounded-xl font-bold text-sm">Update Slot</button>
                    <button type="button" onclick="closeModal()" class="flex-1 bg-slate-100 text-slate-500 py-3 rounded-xl font-bold text-sm">Cancel</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openAssignModal(day, time) {
            document.getElementById('displayDayTime').innerText = day + " (" + time + ")";
            document.getElementById('inputDay').value = day;
            document.getElementById('inputTime').value = time;
            document.getElementById('assignModal').classList.replace('hidden', 'flex');
        }
        function closeModal() {
            document.getElementById('assignModal').classList.replace('flex', 'hidden');
        }
    </script>
</body>
</html>