<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Courses | The Quantum Squad</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; }
        .nav-link { font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; transition: all 0.2s; }
        .nav-link:hover { color: #2563eb; }
        .active-link { color: #2563eb; border-bottom: 2px solid #2563eb; padding-bottom: 4px; }
        
        .badge-c { background: #dbeafe; color: #1e40af; } 
        .badge-e { background: #fef3c7; color: #92400e; } 
        .badge-r { background: #f3e8ff; color: #6b21a8; } 
        
        .enroll-card { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .enrolled { border-color: #2563eb; background-color: #eff6ff; }
        
        /* Toast Notification Styles */
        #toast { visibility: hidden; min-width: 250px; margin-left: -125px; background-color: #333; color: #fff; text-align: center; border-radius: 12px; padding: 16px; position: fixed; z-index: 100; left: 50%; bottom: 30px; font-size: 12px; font-weight: 800; text-transform: uppercase; }
        #toast.show { visibility: visible; -webkit-animation: fadein 0.5s, fadeout 0.5s 2.5s; animation: fadein 0.5s, fadeout 0.5s 2.5s; }
        @-webkit-keyframes fadein { from {bottom: 0; opacity: 0;} to {bottom: 30px; opacity: 1;} }
        @keyframes fadein { from {bottom: 0; opacity: 0;} to {bottom: 30px; opacity: 1;} }
        @-webkit-keyframes fadeout { from {bottom: 30px; opacity: 1;} to {bottom: 0; opacity: 0;} }
        @keyframes fadeout { from {bottom: 30px; opacity: 1;} to {bottom: 0; opacity: 0;} }
    </style>
</head>
<body class="p-4 md:p-10">

    <div id="toast">Changes Saved!</div>

    <div class="max-w-6xl mx-auto">
        <nav class="bg-white border border-slate-200 px-8 py-5 rounded-3xl mb-10 flex flex-wrap justify-between items-center shadow-sm sticky top-5 z-50">
            <div class="text-xl font-black italic tracking-tighter uppercase">
                THE <span class="text-blue-600">QUANTUM</span> SQUAD
            </div>
            <div class="flex gap-6 items-center mt-4 md:mt-0">
                <a href="/dashboard" class="nav-link text-slate-400">Home</a>
                <a href="/timetable" class="nav-link text-slate-400">Timetable</a>
                <a href="/courses" class="nav-link active-link">Courses</a>
            </div>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
            
            <div class="lg:col-span-1 space-y-6">
                <div class="bg-blue-600 p-8 rounded-[2.5rem] shadow-xl text-white">
                    <h2 class="text-xs font-black uppercase tracking-[0.2em] mb-2 opacity-80">My Academic Load</h2>
                    <div class="flex justify-between items-end">
                        <div>
                            <span class="text-4xl font-black italic" id="total-units-display">0</span>
                            <span class="text-[10px] font-bold uppercase block opacity-70">Total Units</span>
                        </div>
                        <div class="text-right">
                            <span class="text-xl font-bold italic" id="course-count">0</span>
                            <span class="text-[10px] font-bold uppercase block opacity-70">Courses</span>
                        </div>
                    </div>
                </div>

                <div class="bg-white p-8 rounded-[2.5rem] shadow-lg border border-slate-200">
                    <h3 class="text-sm font-black uppercase text-slate-900 mb-4 flex items-center gap-2">💡 Info</h3>
                    <p class="text-xs text-slate-500 leading-relaxed">
                        <b>Compulsory</b> & <b>Required</b> courses are auto-enrolled. You must manually manage your <b>Electives</b>.
                    </p>
                </div>
            </div>

            <div class="lg:col-span-2">
                <div class="bg-white rounded-[2.5rem] shadow-xl border border-slate-200 overflow-hidden">
                    <div class="p-8 border-b border-slate-100 bg-slate-50/50">
                        <h2 class="text-xl font-black text-slate-900">Academic Catalog</h2>
                    </div>

                    <div class="p-6 space-y-4">
                        <% courses.forEach(course => { 
                            let typeBadge = 'badge-c';
                            if(course.course_type === 'Elective') typeBadge = 'badge-e';
                            if(course.course_type === 'Required') typeBadge = 'badge-r';
                            
                            // AUTO-ENROLL LOGIC: Compulsory and Required are locked. 
                            // Electives depend on whether 'is_enrolled' is true from the DB.
                            const isAuto = (course.course_type === 'Compulsory' || course.course_type === 'Required');
                            const isEnrolled = isAuto || course.is_enrolled;
                        %>
                        <div class="enroll-card p-6 border rounded-[2rem] flex flex-wrap md:flex-nowrap justify-between items-center gap-6 
                            <%= isEnrolled ? 'enrolled border-blue-200' : 'border-slate-100 bg-white' %>" 
                            id="course-<%= course.course_code %>" 
                            data-units="<%= course.units %>">
                            
                            <div class="flex gap-6 items-center">
                                <div class="w-14 h-14 bg-slate-50 rounded-2xl flex items-center justify-center font-black text-blue-600 text-xs border border-slate-100">
                                    <%= course.course_code %>
                                </div>
                                <div>
                                    <div class="flex items-center gap-3 mb-1">
                                        <h4 class="font-black text-slate-900 text-sm leading-tight"><%= course.course_title %></h4>
                                        <span class="<%= typeBadge %> px-2 py-0.5 rounded-md font-black text-[7px] uppercase"><%= course.course_type %></span>
                                    </div>
                                    <p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest italic">👤 <%= course.lecturer %> • <%= course.units %> Units</p>
                                </div>
                            </div>

                            <div class="w-full md:w-auto">
                                <% if(isAuto) { %>
                                    <span class="text-[9px] font-black text-blue-400 uppercase tracking-widest mr-4 px-4 py-2 border border-blue-100 rounded-xl">Auto-Enrolled</span>
                                <% } else { %>
                                    <button onclick="toggleEnrollment('<%= course.course_code %>', <%= course.units %>)" 
                                            class="enroll-btn w-full md:w-auto px-6 py-3 rounded-2xl text-[10px] font-black uppercase tracking-widest transition-all
                                            <%= isEnrolled ? 'bg-white text-red-500 border border-red-100 hover:bg-red-50' : 'bg-blue-600 text-white shadow-lg shadow-blue-200 hover:bg-blue-700' %>">
                                        <%= isEnrolled ? 'Drop Course' : 'Enroll Now' %>
                                    </button>
                                <% } %>
                            </div>
                        </div>
                        <% }); %>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <script>
        function showToast(msg, isError = false) {
            const toast = document.getElementById("toast");
            toast.innerText = msg;
            toast.style.backgroundColor = isError ? "#ef4444" : "#10b981";
            toast.className = "show";
            setTimeout(() => { toast.className = toast.className.replace("show", ""); }, 3000);
        }

        function toggleEnrollment(courseCode, units) {
            const card = document.getElementById(`course-${courseCode}`);
            const btn = card.querySelector('.enroll-btn');
            const isEnrolling = btn.innerText === 'ENROLL NOW';
            const action = isEnrolling ? 'add' : 'remove';

            // 1. Send data to the server
            fetch(`/enroll-course/${courseCode}`, { 
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: action })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // 2. Update UI only after server confirms success
                    if(isEnrolling) {
                        card.classList.add('enrolled', 'border-blue-200');
                        btn.innerText = 'DROP COURSE';
                        btn.className = 'enroll-btn w-full md:w-auto px-6 py-3 rounded-2xl text-[10px] font-black uppercase tracking-widest transition-all bg-white text-red-500 border border-red-100 hover:bg-red-50';
                        updateStats(units, 1);
                        showToast("Course Added Successfully");
                    } else {
                        card.classList.remove('enrolled', 'border-blue-200');
                        btn.innerText = 'ENROLL NOW';
                        btn.className = 'enroll-btn w-full md:w-auto px-6 py-3 rounded-2xl text-[10px] font-black uppercase tracking-widest transition-all bg-blue-600 text-white shadow-lg shadow-blue-200 hover:bg-blue-700';
                        updateStats(-units, -1);
                        showToast("Course Removed");
                    }
                } else {
                    showToast(data.message || "Failed to save", true);
                }
            })
            .catch(err => {
                console.error("Network error:", err);
                showToast("Connection Error", true);
            });
        }

        function updateStats(unitChange, countChange) {
            const unitEl = document.getElementById('total-units-display');
            const countEl = document.getElementById('course-count');
            
            let currentUnits = parseInt(unitEl.innerText) || 0;
            let currentCount = parseInt(countEl.innerText) || 0;

            unitEl.innerText = currentUnits + unitChange;
            countEl.innerText = currentCount + countChange;
        }

        // INITIAL CALCULATION ON PAGE LOAD
        window.onload = () => {
            let totalUnits = 0;
            let totalCount = 0;
            
            // Find every card that is currently enrolled (including auto-enrolled ones)
            document.querySelectorAll('.enrolled').forEach(card => {
                const u = parseInt(card.getAttribute('data-units')) || 0;
                totalUnits += u;
                totalCount++;
            });

            document.getElementById('total-units-display').innerText = totalUnits;
            document.getElementById('course-count').innerText = totalCount;
        }
    </script>
</body>
</html>