<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Courses | The Quantum Squad</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; }
        .nav-link { font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; transition: all 0.2s; }
        .nav-link:hover { color: #2563eb; }
        .active-link { color: #2563eb; border-bottom: 2px solid #2563eb; padding-bottom: 4px; }
    </style>
</head>
<body class="p-4 md:p-10">

    <div class="max-w-6xl mx-auto">
        <nav class="bg-white border border-slate-200 px-8 py-5 rounded-3xl mb-10 flex flex-wrap justify-between items-center shadow-sm sticky top-5 z-50">
            <div class="text-xl font-black italic tracking-tighter uppercase">
                THE <span class="text-blue-600">QUANTUM</span> SQUAD
            </div>
            
            <div class="flex gap-6 items-center mt-4 md:mt-0">
                <a href="/dashboard" class="nav-link text-slate-400">Home</a>
                <a href="/timetable" class="nav-link text-slate-400">Timetable</a>
                <a href="/courses" class="nav-link active-link">Courses</a>
                <a href="/announcements" class="nav-link text-slate-400">News</a>
            </div>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
            
            <div class="lg:col-span-1">
                <div class="bg-white p-8 rounded-[2.5rem] shadow-xl border border-slate-200 sticky top-32">
                    <h2 class="text-2xl font-black mb-6 text-slate-900">Add New Unit</h2>
                    
                    <form action="/add-course" method="POST" class="space-y-5">
                        <div>
                            <label class="text-[10px] font-black uppercase text-slate-400 ml-1">Course Code</label>
                            <input type="text" name="course_code" placeholder="e.g. GST101" required 
                                   class="w-full p-4 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-2 focus:ring-blue-500 outline-none font-bold">
                        </div>
                        
                        <div>
                            <label class="text-[10px] font-black uppercase text-slate-400 ml-1">Course Title</label>
                            <input type="text" name="course_title" placeholder="e.g. Logic & Philosophy" required 
                                   class="w-full p-4 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-2 focus:ring-blue-500 outline-none">
                        </div>

                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="text-[10px] font-black uppercase text-slate-400 ml-1">Credit Units</label>
                                <input type="number" name="units" placeholder="Units" required 
                                       class="w-full p-4 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-2 focus:ring-blue-500 outline-none font-black text-blue-600">
                            </div>
                            <div>
                                <label class="text-[10px] font-black uppercase text-slate-400 ml-1">Lecturer</label>
                                <input type="text" name="lecturer" placeholder="Lecturer" required 
                                       class="w-full p-4 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-2 focus:ring-blue-500 outline-none">
                            </div>
                        </div>

                        <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-black py-5 rounded-2xl shadow-lg shadow-blue-100 transition-all uppercase tracking-widest text-xs mt-4">
                            Save Course
                        </button>
                    </form>
                </div>
            </div>

            <div class="lg:col-span-2">
                <div class="bg-white rounded-[2.5rem] shadow-xl border border-slate-200 overflow-hidden">
                    <div class="p-8 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
                        <h2 class="text-xl font-black text-slate-900">Academic Catalog</h2>
                        <div class="flex gap-4">
                            <span class="text-[10px] font-bold text-slate-400 uppercase bg-white border border-slate-200 px-3 py-1 rounded-full">
                                Courses: <%= courses.length %>
                            </span>
                        </div>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-slate-50 border-b border-slate-100">
                                    <th class="p-6 text-[10px] font-black uppercase text-slate-400">Code</th>
                                    <th class="p-6 text-[10px] font-black uppercase text-slate-400">Title</th>
                                    <th class="p-6 text-[10px] font-black uppercase text-slate-400 text-center">Units</th>
                                    <th class="p-6 text-[10px] font-black uppercase text-slate-400">Lecturer</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% 
                                    let totalUnits = 0; 
                                    if (courses.length > 0) { 
                                        courses.forEach(course => { 
                                            totalUnits += parseInt(course.units || 0);
                                %>
                                    <tr class="border-b border-slate-50 hover:bg-blue-50/20 transition-colors">
                                        <td class="p-6 font-black text-blue-600 text-sm"><%= course.course_code %></td>
                                        <td class="p-6 font-bold text-slate-700 text-sm"><%= course.course_title %></td>
                                        <td class="p-6 text-center">
                                            <span class="font-black text-slate-900"><%= course.units %></span>
                                        </td>
                                        <td class="p-6 text-xs text-slate-500 italic"><%= course.lecturer %></td>
                                    </tr>
                                <% }); } %>
                            </tbody>
                        </table>
                    </div>

                    <div class="p-8 bg-blue-600 flex justify-between items-center text-white">
                        <div class="flex flex-col">
                            <span class="text-[10px] font-bold uppercase tracking-widest opacity-80">Semester Load</span>
                            <span class="text-2xl font-black italic">Cumulative Result</span>
                        </div>
                        <div class="text-right">
                            <span class="text-[10px] font-bold uppercase tracking-widest opacity-80 block mb-1">Total Credit Units</span>
                            <span class="text-4xl font-black tracking-tighter"><%= totalUnits %></span>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

</body>
</html>