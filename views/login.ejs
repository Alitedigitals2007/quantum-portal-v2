<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | Quantum Squad</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap" rel="stylesheet">
</head>
<body class="bg-slate-50 flex items-center justify-center min-h-screen p-6">

    <div class="bg-white border border-slate-200 shadow-xl rounded-[32px] w-full max-w-md p-10">
        <div class="text-center mb-8">
            <h1 class="text-2xl font-extrabold text-slate-900">Quantum<span class="text-blue-600">Squad</span></h1>
            <p class="text-xs font-bold text-slate-400 uppercase tracking-widest mt-1">Identity Verification</p>
        </div>

        <% if (locals.error) { %>
            <div class="mb-6 p-4 bg-red-50 text-red-600 text-xs font-bold rounded-xl border border-red-100">
                ⚠️ <%= error %>
            </div>
        <% } %>

        <form action="/login" method="POST" class="space-y-5">
            <div>
                <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-2 ml-1">Matric Number</label>
                <input type="text" name="username" required placeholder="e.g. 210542" 
                    class="w-full p-4 bg-slate-50 rounded-2xl text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <div>
                <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-2 ml-1">Access Code</label>
                <input type="password" name="password" required placeholder="••••••••" 
                    class="w-full p-4 bg-slate-50 rounded-2xl text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <button type="submit" class="w-full bg-slate-900 text-white p-4 rounded-2xl font-bold text-sm hover:bg-blue-600 transition shadow-lg shadow-blue-900/10">
                Authorize Access
            </button>
        </form>
    </div>

</body>
</html>